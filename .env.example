# ProspectAI Scale — copy to .env and adjust
APP_NAME=ProspectAI Scale
APP_ENV=development
DEBUG=true

# SQLite (dev). Production: postgresql+psycopg://user:pass@host:5432/prospectai
# DATABASE_URL=sqlite:///./prospectai.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Sessions dir for Instagram (never commit session files)
# SESSIONS_DIR=./backend/data/sessions

# Instagram adapter: stub (default/CI) | instagrapi (produção local)
INSTAGRAM_ADAPTER=stub

# Anti-ban (por conta)
ANTIBAN_MAX_DM_PER_ACCOUNT_PER_DAY=50
ANTIBAN_MIN_DELAY_SEC=120
ANTIBAN_MAX_DELAY_SEC=300
ANTIBAN_CONSECUTIVE_FAILURE_THRESHOLD=5
ANTIBAN_WARMUP_ENABLED=true
# Proxies opcionais (vírgula). Ex: http://user:pass@host:8080,socks5://host:1080
# PROXY_URLS=
